# APPLICATION — loopback quick start; configure HTTPS before remote access
APP_ENV=production
PUBLIC_ORIGIN=http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080

# DATABASE — independent product database; generate distinct random passwords
DB_NAME=ai_soar
DB_USER=ai_soar
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
DATABASE_URL=postgresql+psycopg://${DB_USER}:${POSTGRES_PASSWORD}@db:5432/${DB_NAME}

# AUTH — no default users; bootstrap once, then remove the bootstrap secret
BOOTSTRAP_TOKEN=
SESSION_HOURS=8
# false is allowed only for loopback HTTP; use true behind HTTPS
COOKIE_SECURE=false

# AI PROVIDERS — mock produces deterministic TEST-provider analysis
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_URL=https://api.openai.com/v1
LOCAL_AI_URL=
LOCAL_AI_MODEL=
LOCAL_AI_TOKEN=
LOCAL_AI_CA_FILE=
OLLAMA_URL=
OLLAMA_MODEL=

# INGESTION — tenant comes from authenticated identity, never the JSON body
ENABLE_DEMO=false
MAX_REQUEST_BYTES=64000

# CONNECTORS — standalone default; optional upstreams unconfigured
CORE_MODE=standalone
CORE_API_URL=
CORE_API_TOKEN=
CORE_API_CA_FILE=
CORE_TENANT_ID=
CORE_MAX_PAGES=100
CORE_MAX_ITEMS=20000

# SOAR — only dry_run is implemented; vendor selectors fail closed
SOAR_EXECUTOR=dry_run
PROTECTED_ASSETS=
PROTECTED_NETWORKS=
LAB_ASSET_IDS=
POLICY_FILE=config/policy.yml
SHUFFLE_URL=
SHUFFLE_API_KEY=
SHUFFLE_WORKFLOW_ID=
PFSENSE_URL=
PFSENSE_API_TOKEN=
PFSENSE_API_CONTRACT=

# TLS — verification always on; local HTTP needs explicit opt-in
ALLOW_INSECURE_HTTP=false
TRUSTED_HTTP_HOSTS=

# LOGGING — standard access logs only; never log request/provider bodies
LOG_LEVEL=info

# LIMITS
HTTP_TIMEOUT_SECONDS=15
PROVIDER_TIMEOUT_SECONDS=60
EXECUTOR_TIMEOUT_SECONDS=60
MAX_EVIDENCE=20
MAX_CONTEXT_CHARS=32000
MAX_RESPONSE_BYTES=2000000
