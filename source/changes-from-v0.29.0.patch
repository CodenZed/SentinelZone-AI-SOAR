+    next_offset: int | None
+
+
+class HealthView(Contract):
+    status: Literal["healthy", "degraded"]
+    database: Literal["healthy", "unavailable"]
+    core_backend: str
+    core_mode: Literal["mock", "real"]
+    ai_provider: str
+    soar_executor: str
+    executor_status: str
+    dry_run: bool
+    version: str
+
