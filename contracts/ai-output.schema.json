      },
      "required": [
        "text",
        "evidence_event_ids"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "limitations": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Limitations",
          "type": "string"
        }
      },
      "required": [
        "text",
        "limitations"
